FROM skorlok/php:base AS base

RUN apk add --no-cache build-base autoconf libpng-dev libxml2-dev oniguruma-dev

WORKDIR /app/php

RUN wget -qO- https://www.php.net/distributions/php-7.0.33.tar.gz | tar xz --strip-components=1 &&\
    ./configure --with-config-file-path=/opt/php/\
        --disable-ctype\
        --disable-fileinfo\
        --disable-opcache\
        --disable-pdo\
        --disable-posix\
        --disable-session\
        --disable-tokenizer\
        --disable-xmlreader\
        --disable-xmlwriter\
        --without-iconv\
        --enable-json\
        --enable-xml\
        --enable-libxml\
        --enable-mbstring\
        --enable-pcntl\
        --enable-sockets\
        --with-gd\
        --enable-mysqlnd --with-mysqli=mysqlnd\
        --with-openssl=/opt/openssl1.1\
        --with-zlib\
        --with-xmlrpc\
        --with-curl=/opt/curl8\
        --with-openssl-dir=/opt/openssl1.1&&\
    make -j$(nproc) &&\
    make install


RUN strip /usr/local/bin/php

RUN strip /opt/openssl1.1/lib/libcrypto.so.1.1 /opt/openssl1.1/lib/libssl.so.1.1 /usr/lib/libxml2.so.2 /opt/curl8/lib/libcurl.so.4 /usr/lib/libpng16.so.16 /usr/lib/liblzma.so.5

FROM alpine:latest

COPY --from=base /opt/openssl1.1/lib/libcrypto.so.1.1 /opt/openssl1.1/lib/libcrypto.so.1.1
COPY --from=base /opt/openssl1.1/lib/libssl.so.1.1 /opt/openssl1.1/lib/libssl.so.1.1
COPY --from=base /opt/curl8/lib/libcurl.so.4 /opt/curl8/lib/libcurl.so.4
COPY --from=base /usr/lib/libxml2.so.2 /usr/lib/libxml2.so.2
COPY --from=base /usr/lib/libpng16.so.16 /usr/lib/libpng16.so.16
COPY --from=base /usr/lib/liblzma.so.5 /usr/lib/liblzma.so.5

COPY --from=base /usr/local/bin/php /usr/local/bin/php7.0

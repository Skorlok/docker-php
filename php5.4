FROM ghcr.io/skorlok/docker-php:base AS lib
FROM alpine:latest AS base
COPY --from=lib /opt/ /opt/
ARG TARGETARCH

RUN apk add --no-cache build-base autoconf libxml2-dev libpng-dev libzip-dev && apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/v3.10/main/ gcc=8.3.0-r0

WORKDIR /app/php

RUN sed -i 's/__has_builtin (__builtin_dynamic_object_size)/0/g' /usr/include/fortify/fortify-headers.h

RUN wget -qO- http://museum.php.net/php5/php-5.4.45.tar.gz | tar xz --strip-components=1 &&\
	if [ "$TARGETARCH" = "arm64" ]; then CONFIG_FLAGS="--host=aarch64-unknown-linux-gnu --build=aarch64-unknown-linux-gnu"; else CONFIG_FLAGS=""; fi &&\
	./configure $CONFIG_FLAGS --with-config-file-path=/opt/php/\
		--disable-cgi\
		--without-pear\
		--disable-ctype\
		--disable-fileinfo\
		--without-iconv\
		--disable-pdo\
		--without-pdo-sqlite\
		--disable-posix\
		--disable-session\
		--disable-tokenizer\
		--disable-xmlreader\
		--disable-xmlwriter\
		--enable-json\
		--enable-xml\
		--enable-mbstring\
		--enable-pcntl\
		--enable-sockets\
		--with-gd\
		--enable-mysqlnd --with-mysqli=mysqlnd\
		--with-openssl=/opt/openssl1.0\
		--with-zlib\
		--enable-zip\
		--with-xmlrpc\
		--with-curl=/opt/curl7\
		--with-openssl-dir=/opt/openssl1.0&&\
	make -j$(nproc) && make install


RUN strip /usr/local/bin/php

RUN if [ "$TARGETARCH" = "arm64" ]; then FLAG="aarch64"; else FLAG="x86_64"; fi && mkdir /app/libs/ && cp /lib/ld-musl-$FLAG.so.1 /app/libs/ && strip /app/libs/ld-musl-$FLAG.so.1

RUN cp /usr/lib/libz.so.1 /usr/lib/libxml2.so.2 /usr/lib/liblzma.so.5 /usr/lib/libpng16.so.16 /usr/lib/libzstd.so.1 /usr/lib/libzip.so.5 /usr/lib/libbz2.so.1 /usr/lib/libcrypto.so.3\
	/app/libs/

FROM busybox:musl

COPY --from=base /app/libs/ /lib/
COPY --from=lib /opt/openssl1.0/lib/libcrypto.so.1.0.0 /opt/openssl1.0/lib/libcrypto.so.1.0.0
COPY --from=lib /opt/openssl1.0/lib/libssl.so.1.0.0 /opt/openssl1.0/lib/libssl.so.1.0.0
COPY --from=lib /opt/curl7/lib/libcurl.so.4 /opt/curl7/lib/libcurl.so.4

COPY --from=base /usr/local/bin/php /usr/local/bin/php

ADD https://curl.se/ca/cacert.pem /etc/ssl/cert.pem

FROM skorlok/php:base AS lib
FROM alpine:latest AS base
COPY --from=lib /opt/ /opt/
ARG TARGETARCH

RUN apk add --no-cache build-base autoconf libxml2-dev libpng-dev openssl-dev sqlite-dev oniguruma-dev linux-headers && apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/v3.20/main/ gcc=13.2.1_git20240309-r1

WORKDIR /app/php

RUN export PKG_CONFIG_PATH=/opt/curlssl3/lib/pkgconfig && wget -qO- https://www.php.net/distributions/php-8.1.34.tar.gz | tar xz --strip-components=1 &&\
	./configure\
		--disable-cgi\
		--without-pear\
		--disable-phpdbg\
		--disable-ctype\
		--disable-fileinfo\
		--disable-opcache\
		--without-iconv\
		--disable-huge-code-pages\
		--disable-opcache-jit\
		--disable-pdo\
		--without-pdo-sqlite\
		--disable-posix\
		--disable-session\
		--disable-tokenizer\
		--disable-xmlreader\
		--disable-xmlwriter\
		--enable-xml\
		--enable-mbstring\
		--enable-pcntl\
		--enable-sockets\
		--enable-gd\
		--enable-mysqlnd --with-mysqli=mysqlnd\
		--with-openssl\
		--with-zlib\
		--with-curl=/opt/curlssl3&&\
	make -j$(nproc) && make install

RUN wget -qO- https://codeload.github.com/php/pecl-networking-xmlrpc/tar.gz/refs/heads/master | tar -xz --strip-components=1 &&\
	/usr/local/bin/phpize &&\
	./configure --with-php-config=/usr/local/bin/php-config &&\
	make -j$(nproc) && make install

RUN strip /usr/local/bin/php && echo "extension=xmlrpc.so" > /usr/local/lib/php.ini

RUN if [ "$TARGETARCH" = "arm64" ]; then FLAG="aarch64"; else FLAG="x86_64"; fi && mkdir /app/libs/ && cp /lib/ld-musl-$FLAG.so.1 /app/libs/ && strip /app/libs/ld-musl-$FLAG.so.1

RUN cp /usr/lib/libz.so.1 /usr/lib/libxml2.so.2 /usr/lib/liblzma.so.5 /usr/lib/libpng16.so.16 /usr/lib/libsqlite3.so.0 /usr/lib/libonig.so.5 /usr/lib/libcrypto.so.3 /usr/lib/libssl.so.3\
	/app/libs/

FROM scratch

COPY --from=base /app/libs/ /lib/
COPY --from=lib /opt/curlssl3/lib/libcurl.so.4 /opt/curlssl3/lib/libcurl.so.4

COPY --from=base /usr/local/bin/php /usr/local/bin/php

COPY --from=base /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/

COPY --from=base /usr/local/lib/php.ini /usr/local/lib/php.ini

ADD https://curl.se/ca/cacert.pem /etc/ssl/cert.pem

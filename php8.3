FROM alpine:latest AS base
ARG TARGETARCH

RUN apk add --no-cache build-base autoconf libxml2-dev libpng-dev curl-dev openssl-dev sqlite-dev oniguruma-dev linux-headers

WORKDIR /app/php

RUN wget -qO- https://www.php.net/distributions/php-8.3.30.tar.gz | tar xz --strip-components=1 &&\
    ./configure\
        --disable-ctype\
        --disable-fileinfo\
        --disable-opcache\
        --disable-posix\
        --disable-session\
        --disable-tokenizer\
        --disable-xmlreader\
        --disable-xmlwriter\
        --without-iconv\
        --enable-xml\
        --enable-mbstring\
        --enable-pcntl\
        --enable-sockets\
        --enable-gd\
        --enable-mysqlnd --with-mysqli=mysqlnd\
        --with-openssl\
        --with-zlib\
        --with-curl&&\
    make -j$(nproc) &&\
    make install

RUN wget -qO- https://codeload.github.com/php/pecl-networking-xmlrpc/tar.gz/refs/heads/master | tar -xz --strip-components=1 &&\
    /usr/local/bin/phpize &&\
    ./configure --with-php-config=/usr/local/bin/php-config &&\
    make -j$(nproc) &&\
    make install

RUN strip /usr/local/bin/php && echo "extension=xmlrpc.so" > /usr/local/lib/php.ini

RUN if [ "$TARGETARCH" = "arm64" ]; then FLAG="aarch64"; else FLAG="x86_64"; fi && mkdir /app/libs/ && cp /lib/ld-musl-$FLAG.so.1 /app/libs/ && strip /app/libs/ld-musl-$FLAG.so.1

RUN strip /usr/lib/libz.so.1 /usr/lib/libxml2.so.2 /usr/lib/liblzma.so.5 /usr/lib/libpng16.so.16 /usr/lib/libsqlite3.so.0 /usr/lib/libonig.so.5 /usr/lib/libssl.so.3 /usr/lib/libcrypto.so.3 /usr/lib/libcurl.so.4 /usr/lib/libcares.so.2\
          /usr/lib/libnghttp2.so.14 /usr/lib/libidn2.so.0 /usr/lib/libpsl.so.5 /usr/lib/libzstd.so.1 /usr/lib/libbrotlidec.so.1 /usr/lib/libunistring.so.5 /usr/lib/libbrotlicommon.so.1 /usr/lib/libnghttp3.so.9

FROM scratch

COPY --from=base /app/libs/ /lib/
COPY --from=base /usr/lib/libz.so.1 /usr/lib/libz.so.1
COPY --from=base /usr/lib/libcrypto.so.3 /usr/lib/libcrypto.so.3
COPY --from=base /usr/lib/libssl.so.3 /usr/lib/libssl.so.3
COPY --from=base /usr/lib/libcurl.so.4 /usr/lib/libcurl.so.4
COPY --from=base /usr/lib/libxml2.so.2 /usr/lib/libxml2.so.2
COPY --from=base /usr/lib/liblzma.so.5 /usr/lib/liblzma.so.5
COPY --from=base /usr/lib/libpng16.so.16 /usr/lib/libpng16.so.16
COPY --from=base /usr/lib/libsqlite3.so.0 /usr/lib/libsqlite3.so.0
COPY --from=base /usr/lib/libonig.so.5 /usr/lib/libonig.so.5
COPY --from=base /usr/lib/libcares.so.2 /usr/lib/libcares.so.2
COPY --from=base /usr/lib/libnghttp2.so.14 /usr/lib/libnghttp2.so.14
COPY --from=base /usr/lib/libidn2.so.0 /usr/lib/libidn2.so.0
COPY --from=base /usr/lib/libpsl.so.5 /usr/lib/libpsl.so.5
COPY --from=base /usr/lib/libzstd.so.1 /usr/lib/libzstd.so.1
COPY --from=base /usr/lib/libbrotlidec.so.1 /usr/lib/libbrotlidec.so.1
COPY --from=base /usr/lib/libunistring.so.5 /usr/lib/libunistring.so.5
COPY --from=base /usr/lib/libbrotlicommon.so.1 /usr/lib/libbrotlicommon.so.1
COPY --from=base /usr/lib/libnghttp3.so.9 /usr/lib/libnghttp3.so.9

COPY --from=base /usr/local/bin/php /usr/local/bin/php

COPY --from=base /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/

COPY --from=base /usr/local/lib/php.ini /usr/local/lib/php.ini

ADD https://curl.se/ca/cacert.pem /etc/ssl/cert.pem

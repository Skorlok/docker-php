FROM skorlok/php:base AS base



WORKDIR /app/php

RUN wget -qO- http://museum.php.net/php5/php-5.3.29.tar.gz | tar xz --strip-components=1 &&\
    ./configure --with-config-file-path=/opt/php/ --disable-ctype\
        --disable-fileinfo\
        --disable-opcache\
        --disable-pdo\
        --disable-posix\
        --disable-session\
        --disable-tokenizer\
        --disable-xmlreader\
        --disable-xmlwriter\
        --without-iconv\
        --enable-json\
        --enable-xml\
        --enable-libxml\
        --enable-mbstring\
        --enable-pcntl\
        --enable-sockets\
        --with-gd\
        --enable-mysqlnd --with-mysqli=mysqlnd\
        --with-openssl=/opt/openssl1.0\
        --with-zlib\
        --with-xmlrpc\
        --with-curl=/opt/curl7\
        --with-openssl-dir=/opt/openssl1.0\
        --with-libxml-dir=/opt/libxml2 &&\
    make -j$(nproc) &&\
    make install

RUN strip /usr/local/bin/php

RUN strip /opt/openssl1.0/lib/libcrypto.so.1.0.0 /opt/openssl1.0/lib/libssl.so.1.0.0 /usr/lib/libpng16.so.16 /opt/curl7/lib/libcurl.so.4 /opt/libxml2/lib/libxml2.so.2

FROM alpine:latest

COPY --from=base /opt/openssl1.0/lib/libcrypto.so.1.0.0 /opt/openssl1.0/lib/libcrypto.so.1.0.0
COPY --from=base /opt/openssl1.0/lib/libssl.so.1.0.0 /opt/openssl1.0/lib/libssl.so.1.0.0
COPY --from=base /opt/curl7/lib/libcurl.so.4 /opt/curl7/lib/libcurl.so.4
COPY --from=base /opt/libxml2/lib/libxml2.so.2 /opt/libxml2/lib/libxml2.so.2
COPY --from=base /usr/lib/libpng16.so.16 /usr/lib/libpng16.so.16

COPY --from=base /usr/local/bin/php /usr/local/bin/php5.3

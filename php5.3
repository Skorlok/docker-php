FROM skorlok/php:base AS lib
FROM alpine:latest AS base
COPY --from=lib /opt/ /opt/

RUN apk add --no-cache build-base autoconf libpng-dev && apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/v3.10/main/ gcc=8.3.0-r0

WORKDIR /app/php
ARG TARGETARCH
RUN wget -qO- http://museum.php.net/php5/php-5.3.29.tar.gz | tar xz --strip-components=1 &&\
    if [ "$TARGETARCH" = "arm64" ]; then CONFIG_FLAGS="--host=aarch64-unknown-linux-gnu --build=aarch64-unknown-linux-gnu"; else CONFIG_FLAGS=""; fi &&\
    ./configure $CONFIG_FLAGS --with-config-file-path=/opt/php/\
        --disable-ctype\
        --disable-fileinfo\
        --disable-opcache\
        --disable-pdo\
        --disable-posix\
        --disable-session\
        --disable-tokenizer\
        --disable-xmlreader\
        --disable-xmlwriter\
        --without-iconv\
        --enable-json\
        --enable-xml\
        --enable-libxml\
        --enable-mbstring\
        --enable-pcntl\
        --enable-sockets\
        --with-gd\
        --enable-mysqlnd --with-mysqli=mysqlnd\
        --with-openssl=/opt/openssl1.0\
        --with-zlib\
        --with-xmlrpc\
        --with-curl=/opt/curl7\
        --with-openssl-dir=/opt/openssl1.0\
        --with-libxml-dir=/opt/libxml2 &&\
    make -j$(nproc) &&\
    make install

RUN strip /usr/local/bin/php

RUN strip /usr/lib/libpng16.so.16

FROM alpine:latest

COPY --from=lib /opt/openssl1.0/lib/libcrypto.so.1.0.0 /opt/openssl1.0/lib/libcrypto.so.1.0.0
COPY --from=lib /opt/openssl1.0/lib/libssl.so.1.0.0 /opt/openssl1.0/lib/libssl.so.1.0.0
COPY --from=lib /opt/curl7/lib/libcurl.so.4 /opt/curl7/lib/libcurl.so.4
COPY --from=lib /opt/libxml2/lib/libxml2.so.2 /opt/libxml2/lib/libxml2.so.2
COPY --from=base /usr/lib/libpng16.so.16 /usr/lib/libpng16.so.16

COPY --from=base /usr/local/bin/php /usr/local/bin/php5.3

RUN wget -O /etc/ssl/certs/ca-certificates.crt https://curl.se/ca/cacert.pem

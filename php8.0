FROM skorlok/php:base AS base

RUN apk add --no-cache libxml2-dev sqlite-dev oniguruma-dev

WORKDIR /app/php

RUN export PKG_CONFIG_PATH=/opt/curl8/lib/pkgconfig:/opt/openssl1.1/lib/pkgconfig && wget -qO- https://www.php.net/distributions/php-8.0.30.tar.gz | tar xz --strip-components=1 &&\
    ./configure --build=x86_64-linux-gnu --host=$TARGETPLATFORM\
        --disable-ctype\
        --disable-fileinfo\
        --disable-opcache\
        --disable-posix\
        --disable-session\
        --disable-tokenizer\
        --disable-xmlreader\
        --disable-xmlwriter\
        --without-iconv\
        --enable-xml\
        --enable-mbstring\
        --enable-pcntl\
        --enable-sockets\
        --enable-gd\
        --enable-mysqlnd --with-mysqli=mysqlnd\
        --with-openssl\
        --with-zlib\
        --with-curl=/opt/curl8&&\
    make -j$(nproc) &&\
    make install

RUN wget -qO- https://codeload.github.com/php/pecl-networking-xmlrpc/tar.gz/refs/heads/master | tar -xz --strip-components=1 &&\
    /usr/local/bin/phpize &&\
    ./configure --with-php-config=/usr/local/bin/php-config &&\
    make -j$(nproc) &&\
    make install

RUN strip /usr/local/bin/php

RUN strip /opt/openssl1.1/lib/libcrypto.so.1.1 /opt/openssl1.1/lib/libssl.so.1.1 /usr/lib/libxml2.so.2 /opt/curl8/lib/libcurl.so.4 /usr/lib/libpng16.so.16 /usr/lib/libonig.so.5 /usr/lib/liblzma.so.5 /usr/lib/libsqlite3.so.0

FROM alpine:latest

COPY --from=base /opt/openssl1.1/lib/libcrypto.so.1.1 /opt/openssl1.1/lib/libcrypto.so.1.1
COPY --from=base /opt/openssl1.1/lib/libssl.so.1.1 /opt/openssl1.1/lib/libssl.so.1.1
COPY --from=base /opt/curl8/lib/libcurl.so.4 /opt/curl8/lib/libcurl.so.4
COPY --from=base /usr/lib/libxml2.so.2 /usr/lib/libxml2.so.2
COPY --from=base /usr/lib/libpng16.so.16 /usr/lib/libpng16.so.16
COPY --from=base /usr/lib/liblzma.so.5 /usr/lib/liblzma.so.5
COPY --from=base /usr/lib/libsqlite3.so.0 /usr/lib/libsqlite3.so.0
COPY --from=base /usr/lib/libonig.so.5 /usr/lib/libonig.so.5

COPY --from=base /usr/local/bin/php /usr/local/bin/php8.0

COPY --from=base /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/

RUN echo "extension=xmlrpc.so" > /usr/local/lib/php.ini

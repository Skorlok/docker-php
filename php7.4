FROM skorlok/php:base AS lib
FROM alpine:latest AS base
COPY --from=lib /opt/ /opt/

RUN apk add --no-cache build-base autoconf libxml2-dev libpng-dev sqlite-dev oniguruma-dev && apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/v3.20/main/ gcc=13.2.1_git20240309-r1

WORKDIR /app/php

RUN export PKG_CONFIG_PATH=/opt/curl8/lib/pkgconfig:/opt/openssl1.1/lib/pkgconfig && wget -qO- https://www.php.net/distributions/php-7.4.33.tar.gz | tar xz --strip-components=1 &&\
    ./configure --with-config-file-path=/opt/php/\
        --disable-ctype\
        --disable-fileinfo\
        --disable-opcache\
        --disable-pdo\
        --disable-posix\
        --disable-session\
        --disable-tokenizer\
        --disable-xmlreader\
        --disable-xmlwriter\
        --without-iconv\
        --enable-json\
        --enable-xml\
        --enable-libxml\
        --enable-mbstring\
        --enable-pcntl\
        --enable-sockets\
        --enable-gd\
        --enable-mysqlnd --with-mysqli=mysqlnd\
        --with-openssl\
        --with-zlib\
        --with-xmlrpc\
        --with-curl=/opt/curl8\
        --with-openssl-dir=/opt/openssl1.1&&\
    make -j$(nproc) &&\
    make install


RUN strip /usr/local/bin/php

RUN strip /lib/ld-musl-x86_64.so.1 /usr/lib/libz.so.1 /usr/lib/libxml2.so.2 /usr/lib/liblzma.so.5 /usr/lib/libpng16.so.16 /usr/lib/libsqlite3.so.0 /usr/lib/libonig.so.5

FROM busybox:musl

COPY --from=base /lib/ld-musl-x86_64.so.1 /lib/ld-musl-x86_64.so.1
COPY --from=base /usr/lib/libz.so.1 /usr/lib/libz.so.1
COPY --from=lib /opt/openssl1.1/lib/libcrypto.so.1.1 /opt/openssl1.1/lib/libcrypto.so.1.1
COPY --from=lib /opt/openssl1.1/lib/libssl.so.1.1 /opt/openssl1.1/lib/libssl.so.1.1
COPY --from=lib /opt/curl8/lib/libcurl.so.4 /opt/curl8/lib/libcurl.so.4
COPY --from=base /usr/lib/libxml2.so.2 /usr/lib/libxml2.so.2
COPY --from=base /usr/lib/liblzma.so.5 /usr/lib/liblzma.so.5
COPY --from=base /usr/lib/libpng16.so.16 /usr/lib/libpng16.so.16
COPY --from=base /usr/lib/libsqlite3.so.0 /usr/lib/libsqlite3.so.0
COPY --from=base /usr/lib/libonig.so.5 /usr/lib/libonig.so.5

COPY --from=base /usr/local/bin/php /usr/local/bin/php

ADD https://curl.se/ca/cacert.pem /etc/ssl/certs/ca-certificates.crt
